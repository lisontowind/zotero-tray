{
  "manifest_version": 2,
  "name": "Zotero Tray",
  "version": "0.1.2",
  "description": "关闭到 Windows 托盘，支持显示窗口和正常退出；不附带可执行程序。",
  "author": "Zotero Tray contributors",
  "applications": {
    "zotero": {
      "id": "zotero-tray@local",
      "update_url": "https://updates.zotero-tray.invalid/updates.json",
      "strict_min_version": "10.0",
      "strict_max_version": "10.0.*"
    }
  }
}
